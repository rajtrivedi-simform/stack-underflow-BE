# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200

# Database (Neon PostgreSQL)
# DATABASE_URL uses connection pooling (PgBouncer); DIRECT_URL bypasses it for migrations/seeds
DATABASE_URL=postgresql://neondb_owner:<password>@ep-<project-id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:<password>@ep-<project-id>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# JWT (secrets must be at least 32 characters)
JWT_ACCESS_SECRET=your_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Business logic
PROFILE_TTL_DAYS=90
